# Free public testnet endpoints that work out of the box (no sign-up).
# Mainnet keys go in .env.mainnet (git-ignored), never here.

# Bitcoin Testnet4 API (required). Esplora-compatible, testnet4 only.
VITE_BITCOIN_API_URL=https://mempool.space/testnet4/api

# Ethereum Sepolia HTTPS RPC (required). Must target chain ID 11155111 and
# allow eth_getLogs from block 0 (vault activity history needs it).
VITE_ETHEREUM_RPC_URL=https://sepolia.gateway.tenderly.co

# Sepolia ERC-4337 bundler (required for smart-account sends). Pimlico's
# public endpoint ignores the key; use a real key for higher rate limits.
VITE_ETHEREUM_BUNDLER_RPC_URL=https://public.pimlico.io/v2/11155111/rpc
VITE_ETHEREUM_BUNDLER_API_KEY=public

# Fiat price feed (CoinGecko /simple/price compatible).
VITE_ASSET_PRICES_URL=https://api.coingecko.com/api/v3/simple/price
