# Bitcoin testnet API base URL (required). Do not point this at mainnet.
VITE_BITCOIN_API_URL=

# Fiat price feed (required for balance display in currency).
VITE_ASSET_PRICES_URL=

# Signed JSON-RPC register worker (required by libqc boot).
VITE_REGISTER_URL=

# Ethereum / bundler vars are unused in the Bitcoin-testnet-only Capacitor build.
# Leave blank; do not enable mainnet by filling these for the first iOS build.
# VITE_ETHEREUM_RPC_URL=
# VITE_ETHEREUM_BUNDLER_RPC_URL=
# VITE_ETHEREUM_BUNDLER_API_KEY=
