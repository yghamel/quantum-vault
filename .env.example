# Bitcoin Testnet API (required). Must be testnet-compatible. Never mainnet.
VITE_BITCOIN_API_URL=

# Ethereum Sepolia HTTPS RPC (required). Must target chain ID 11155111.
VITE_ETHEREUM_RPC_URL=

# Sepolia ERC-4337 bundler (required for smart-account ops).
VITE_ETHEREUM_BUNDLER_RPC_URL=
VITE_ETHEREUM_BUNDLER_API_KEY=

# Fiat price feed (required for balance display in currency).
VITE_ASSET_PRICES_URL=

# Signed JSON-RPC register worker (required by libqc boot).
VITE_REGISTER_URL=

# Optional testnet treasury addresses (public config, not secrets).
# Service-fee collection remains disabled until libqc supports atomic
# recipient+treasury payments. Addresses must still validate when set.
# VITE_BTC_TESTNET_TREASURY_ADDRESS=tb1...
# VITE_ETH_SEPOLIA_TREASURY_ADDRESS=0x...
